<!DOCTYPE ejs>
<html lang="it">
    <%- include('partials/head') %>
    <body>
        <%- include('partials/navbar') %>

        
        <div class="container" data-aos="zoom-in">
            <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <% let validImageIndex = 0; %> 
                    <% ristorante.forEach((recensione, index) => { %>
                        <% if (validImageIndex === 0 && ristorante[0].copertina) { %> 
                            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="<%= validImageIndex %>" class="<%= validImageIndex === 0 ? 'active' : '' %>" aria-label="Slide <%= validImageIndex + 1 %>"></button>
                            <% validImageIndex++; %>  
                        <% } %>
                        <% if (recensione.immagine) { %>  
                            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="<%= validImageIndex %>" class="<%= validImageIndex === 0 ? 'active' : '' %>" aria-label="Slide <%= validImageIndex + 1 %>"></button>
                            <% validImageIndex++; %> 
                        <% } %>
                    <% }); %>
                </div>
                <div class="carousel-inner">
                    <% let firstImageLoaded = false; %> 
                    <% ristorante.forEach((recensione, index) => { %>
                        <% if (ristorante[0].copertina && firstImageLoaded === false) { %>  
                            <div class="carousel-item <%= !firstImageLoaded ? 'active' : '' %> mb-2">
                                <img src="<%= ristorante[0].copertina %>" class="d-block w-100" alt="Immagine Ristorante">
                                <% firstImageLoaded = true; %>
                            </div>
                        <% } %>
                        <% if (recensione.immagine) { %>
                            <div class="carousel-item <%= !firstImageLoaded ? 'active' : '' %> mb-2">
                                <img src="/<%= recensione.immagine %>" class="d-block w-100" alt="Immagine Recensione">                            
                            </div>
                             
                        <% } %>
                    <% }); %>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>

        
        <div class="container-fluid mt-4">
            <div class="row" style="margin-right: 40px; margin-left: 40px;" >
                <div class="col-lg-10 offset-lg-1" >
                    <div class="restaurant-info text-center bg-white p-4 rounded" data-aos="fade-up" >
                        <!-- Titolo del ristorante -->
                        <div class="d-flex justify-content-between align-items-center mt-1 position-relative">
                            <!-- Nome del ristorante al centro -->
                            <h1 class="pasq d-inline-block text-center w-100 position-absolute" style="left: 0; right: 0; margin: auto;"><%= ristorante[0].nome_ristorante %></h1>
                            
                           
                            <form action="/aggiungiPreferiti/<%= ristorante[0].id %>" class="ms-auto" method="POST">

                                <% if (isFavorite) { %>
                                  
                                    <button id="favoriteButton" name="favoriteButton" class="btn btn-outline-danger position-relative ms-auto" aria-label="Aggiungi ai Preferiti" 
                                        style="width: auto; padding: 10px 20px; border-radius: 30px; background-color: red; border: 2px solid red; color: white; font-size: 16px; font-weight: bold; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); transition: background-color 0.3s, color 0.3s, box-shadow 0.3s, transform 0.2s;">
                                        Preferiti | <%= nPreferiti %>
                                    </button>
                                <% } else { %>
                                    
                                    <button id="favoriteButton" name="favoriteButton" class="btn btn-outline-danger position-relative ms-auto" aria-label="Aggiungi ai Preferiti" 
                                        style="width: auto; padding: 10px 20px; border-radius: 30px; background-color: white; border: 2px solid red; color: red; font-size: 16px; font-weight: bold; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); transition: background-color 0.3s, color 0.3s, box-shadow 0.3s, transform 0.2s;">
                                        Preferiti | <%= nPreferiti %>
                                    </button>
                                <% } %>
                                
                            </form>
                        </div>
        
                     
                        <p class="lead mt-3" style="background-color: #f5f5ef">
                            <% if (ristorante[0].descrizione !== ' ' && ristorante[0].descrizione !== null && ristorante[0].descrizione !== '') { %>
                              <%= ristorante[0].descrizione %>
                            <% } else { %>
                              <span style="color: red;">Attenzione: la descrizione non è disponibile.</span>
                            <% } %>
                        </p>                        <hr>

                        <a href="https://maps.google.com/?q=<%= ristorante[0].indirizzo %>">
                            <i class="bi bi-geo-alt"></i> <%= ristorante[0].indirizzo %>
                        </a>
        
                      
                        <div class="opening-hours mt-4">Orari di apertura:</div>
                        <div class="mb-4 mt-2"> <%= ristorante[0].orari %></div>
        
                       
                        <a href="<%= ristorante[0].menu %>" class="btn btn-outline-dark me-3" download="<%= ristorante[0].nome_ristorante %> : Menu">Scopri il Menu</a>
                        <% if(username) { %>
                            <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#prenotaModal">Prenota</a>
                        <% } else { %>
                            <a href="/login" class="btn btn-primary">
                                Accedi e Prenota
                            </a>
                        <% } %>
                     </div>
                     
                   
                    <div class="promotions mt-3 bg-white p-4 rounded shadow no" data-aos="fade-up">
                        <h4 class="mb-3">Promozioni:</h4>
                        <% if (ristorante[0].promo) { %>
                            <div class="alert alert-info" role="alert">
                                <h8 class="mb-0" style="font-size: 1rem"><%= ristorante[0].promo %></h8>
                            </div>
                        <% } else { %>
                            <div class="alert alert-info" role="alert">
                                Al momento non ci sono promozioni disponibili. Controlla nuovamente in futuro!
                            </div>
                        <% } %>
                    </div>
            
                    


                    <div class="container mt-5 mb-5" data-aos="fade-up">
                        <div class="row">
                            <div class="card bg-white p-4">
                                <div class="d-flex justify-content-between align-items-center mb-4 ms-1">
                                    <h4 class="mb-0">Valutazione Media: 
                                        <span class="text-muted">
                                            <%= (ristorante[0] && ristorante[0].valutazione_media) || 'N/A' %> su 5
                                        </span>
                                    </h4>
                                    <% if(username && !possiedeRecensione) { %>
                                    <a href="#" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#recensioneModal">
                                        Scrivi una Recensione
                                    </a>
                                    <% } else if (possiedeRecensione){ %>
                                        <a>
                                            <button type="button" class="btn btn-outline-danger ms-2" id="confirmDeleteButton" data-username="<%= username %>" data-ristorante-id="<%= ristorante[0].id %>"> Elimina la tua recensioene</button>
                                        </a>
                                    <% } else {%>
                                        <a href="/login" class="btn btn-outline-dark">
                                            Accedi per inserire una recensione
                                        </a>
                                    <% } %>
                                </div>
                    
                                <div id="reviewsContainer">
                                    <% const recensioni = ristorante.filter(item => item.scrittore); %>
                                    <% if (recensioni.length > 0) { %>
                                        <% recensioni.forEach(function(recensione, index) { %>
                                            <div class="card mb-3 recensione-item <%= index >= 4 ? 'd-none' : '' %>" data-bs-toggle="modal" style="cursor: pointer;">
                                                <div class="card-body d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h5 class="card-title small-text">Recensione di <%= recensione.scrittore || "Utente" %> - <%= recensione.titolo || "Recensione" %></h5>
                                                        <div class="d-flex align-items-center mb-2">
                                                            <span class="text-warning me-2">
                                                                <div class="d-flex justify-content-center small text-warning" style="font-size:14px">
                                                                    <% for (let i = 0; i < Math.round(recensione.valutazione); i++) { %>
                                                                        <a class="star-link"><i class="bi bi-star-fill"></i></a>
                                                                    <% } %>
                                                                    <% for (let i = 0; i < 5 - Math.round(recensione.valutazione); i++) { %>
                                                                        <a class="star-link"><i class="bi bi-star"></i></a>
                                                                    <% } %>
                                                                </div>
                                                            </span>
                                                            <span class="text-muted" style="font-size:14px"><%= recensione.valutazione || "N/A" %>.0 su 5</span>
                                                        </div>
                                                        <p class="card-text" style="font-size:14px"><%= recensione.testo || "Nessun testo disponibile." %></p>
                                                    </div>
                                                    
                                                    <% if (possiedeRistorante) { %>
                                                        <div class="ml-auto">
                                                            <button class="open-reply-modal btn btn-outline-dark" data-scrittore="<%= recensione.scrittore %>" data-bs-toggle="modal" data-bs-target="#replyModal">
                                                                Rispondi
                                                            </button>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% }); %>
                                        <div class="text-center mt-4">
                                            <% if (recensioni.length > 4) { %>
                                                <button id="loadMoreReviews" class="btn btn-outline-dark">Visualizza altre recensioni</button>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <div class="alert alert-info small-text">
                                            😞 Nessuna recensione disponibile. Sii il primo a scrivere una recensione!
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    <%- include('partials/footer') %>

        <div class="modal fade" id="prenotaModal" tabindex="-1" aria-labelledby="prenotaModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="prenotaModalLabel">Prenota un tavolo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/prenota" method="POST">
                            <div class="mb-3">
                                <label for="dataPrenotazione" class="form-label">Data</label>
                                <input type="date" name="dataPrenotazione" class="form-control" id="dataPrenotazione" required min="2024-11-01">
                            </div>
                            <div class="mb-3">
                                <label for="oraPrenotazione" class="form-label">Ora</label>
                                <input type="time" name="oraPrenotazione" class="form-control" id="oraPrenotazione" required>
                            </div>
                            <div class="mb-3">
                                <label for="numeroPersone" class="form-label">Numero di persone</label>
                                <input type="number" name="numeroPersone" class="form-control" id="numeroPersone" required min="1">
                            </div>
                            <input type="hidden" name="ristoranteId" value="<%= ristorante[0].id %>">
                            <button type="submit" class="btn btn-primary">Prenota</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="modal fade" id="replyModal" tabindex="-1" aria-labelledby="replyModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="replyModalLabel">Rispondi alla Recensione</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="replyForm" action="/inviaRisposta" method="POST">
                            <div class="mb-3">
                                <label for="replyMessage" class="form-label">Messaggio</label>
                                <textarea class="form-control" id="replyMessage" name="testo" rows="4" placeholder="Scrivi il tuo messaggio qui..."></textarea>
                            </div>
                            <input type="hidden" id="scrittore" name="scrittore" value=""> <!-- Campo nascosto per lo scrittore -->
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary me-auto">Invia Risposta</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="recensioneModal" tabindex="-1" aria-labelledby="recensioneModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="recensioneModalLabel">Lascia una recensione</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/inserisci-recensione" method="POST" id="formRecensione" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label for="valutazioneRecensione" class="form-label">Valutazione</label>
                                <select class="form-select" id="valutazioneRecensione" name="valutazione" required>
                                    <option value="5">⭐️⭐️⭐️⭐️⭐️</option>
                                    <option value="4">⭐️⭐️⭐️⭐️</option>
                                    <option value="3">⭐️⭐️⭐️</option>
                                    <option value="2">⭐️⭐️</option>
                                    <option value="1">⭐️</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="immagineRecInput" class="form-label">Immagine</label>
                                <input type="file" class="form-control shadow-sm" id="immagineRecInput" name="immagine" accept=".jpg,.jpeg" required>
                                <small class="text-muted">Per migliorare la qualità del nostro servizio ogni recensore deve caricare un immagine. Carica un'immagine (jpg, jpeg). </small>
                            </div>
                            <div class="mb-3 mt-3">
                                <label for="titoloRecensione" class="form-label">Titolo</label>
                                <input type="text" class="form-control" id="titoloRecensione" name="titolo" required>
                            </div>
                            <div class="mb-3">
                                <label for="testoRecensione" class="form-label">Recensione</label>
                                <textarea class="form-control" id="testoRecensione" name="testo" rows="3" required></textarea>
                            </div>
                            <input type="hidden" name="ristoranteId" value="<%= ristorante[0].id %>">
                            <button type="submit" class="btn btn-primary">Invia Recensione</button>
                        </form>
                    </div>
                </div>
            </div>
        </div> 
        <script>
            AOS.init();
        </script>
    </body>    
</html>

<script>
    
    

    document.getElementById('confirmDeleteButton').addEventListener('click', function() {
        const username = this.getAttribute('data-username'); 
        const ristoranteId = this.getAttribute('data-ristorante-id'); 
        console.log('Eliminazione richiesta per:', username, 'ristorante ID:', ristoranteId);  


       

        fetch(`/delete-rec/${username}/${ristoranteId}`, { 
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => {
            if (!response.ok) {
                return response.json().then(data => { throw new Error(data.message); });
            }
            return response.json(); 
        })
        .then(data => {
            console.log('Recensione eliminata con successo:', data.message);
            location.reload(); 
        })
        .catch(error => {
            console.error('Errore durante l\'eliminazione:', error);
            alert('Errore durante l\'eliminazione: ' + error.message);
        });
    });


   
    document.querySelectorAll('.open-reply-modal').forEach(button => {
        button.addEventListener('click', function() {
          
            const scrittore = this.getAttribute('data-scrittore');

            document.getElementById('scrittore').value = scrittore;
            $('#replyModal').modal('show');
        });
    });



    

    

</script>