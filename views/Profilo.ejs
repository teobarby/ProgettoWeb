<!DOCTYPE ejs>
<html lang="it">
    <%- include('partials/head'); %>
        <body>

        <%- include('partials/navbar'); %>

        <header class="bg-dark pt-4 pb-4">
            <div class="container px-4 px-lg-5 my-0">
                <div class="text-center text-white">
                    <h1 class="display-4 fw-bolder">Il Tuo Profilo</h1>
                    <p class="lead fw-normal text-white-50 mb-0">Visualizza e gestisci le informazioni del tuo profilo.</p>
                    <button class="btn btn-outline-light topmarg" id="modificaButton" data-bs-toggle="modal" data-bs-target="#modificaModal">Modifica</button>
                    
                    <button class="btn btn-outline-light topmarg ms-2" id="eliminaButton" data-bs-toggle="modal" data-bs-target="#eliminaModal">Elimina Account</button>
                </div>
            </div>
        </header>

        <section class="py-5">
            <div class="container card px-4 px-lg-5 mt-2 mb-2">
                <div class="row gx-4 gx-lg-5">
                    <div class="col-lg-6 mb-3 mt-4">
                        <h2 class="section-heading mb-4">Informazioni Personali</h2>

                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Nome e Cognome</h5>
                                <p class="card-text"><%= nome %> <%= cognome %></p>                            
                            </div>
                        </div>
                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title">Nome Utente</h5>
                                <p class="card-text"><%= username %></p>
                            </div>
                        </div>
                        
                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title">Email</h5>
                                <p class="card-text"><%= email %></p>
                            </div>
                        </div>
                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title">Numero di telefono</h5>
                                <p class="card-text"><%= cellulare %></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 mb-3 mt-4">
                        <!-- Altri dettagli del profilo -->
                        <h2 class="section-heading mb-4">Preferenze e Statistiche</h2>
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Preferenze Alimentari</h5>
                                <p class="card-text">Indica le tue preferenze alimentari</p>
                            </div>
                        </div>
                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title">Recensioni</h5>
                                <p class="card-text">Fino ad oggi hai scritto 3 recensioni</p>
                            </div>
                        </div>
                       
                    </div>
                    <!-- solo se non possiede il ristorante, se lo possiede appare in alto nella tendina del profilo "gestisci il tuo ristorante", e lo facciamo apparire anche qua direi, al posto di questo tasto , dovrebbe essere una cavolatona -->
                    <div class="text-center mt-5">
                        <button type="button" class="btn btn-outline-dark mb-4" data-bs-toggle="modal" data-bs-target="#informazioniRistoranteModal">Aggiungi il tuo Ristorante</button>
                    </div>
                </div>
            </div>

            
        </section>

        <div class="modal fade" id="eliminaModal" tabindex="-1" aria-labelledby="modificaModalLabel" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="modificaModalLabel">Conferma Eliminazione Account</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <p>Sei sicuro di voler eliminare il tuo account? Questa azione è <strong>irreversibile</strong> e tutti i tuoi dati andranno persi. Non sarà possibile tornare indietro.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark ms-4" data-bs-dismiss="modal">Annulla</button>
                    <button type="button" class="btn btn-outline-danger ms-2" id="confirmDeleteButton" data-username="<%= username %>">Conferma Eliminazione</button>
                </div>
              </div>
            </div>
        </div>

        <div class="modal fade" id="modificaModal" tabindex="-1" aria-labelledby="modificaModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modificaModalLabel">Modifica profilo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="modificaForm">
                            <div class="mb-3">
                                <label for="nomeInput" class="form-label">Nome</label>
                                <input type="text" class="form-control" id="nomeModalInput" required>
                            </div>
                            <div class="mb-3">
                                <label for="cognomeInput" class="form-label">Cognome</label>
                                <input type="text" class="form-control" id="cognomeModalInput" required>
                            </div>
                            <div class="mb-3">
                                <label for="emailInput" class="form-label">Email</label>
                                <input type="email" class="form-control" id="emailModalInput" required>
                            </div>
                            <div class="mb-3">
                                <label for="telefonoInput" class="form-label">Telefono</label>
                                <input type="tel" class="form-control" id="telefonoModalInput" required>
                            </div>
                            <div class="mb-3">
                                <label for="preferenzeInput" class="form-label">Preferenze Alimentari</label>
                                <input type="text" class="form-control" id="preferenzeModalInput" required>
                            </div>
                            <div class="text-center">
                                <button type="submit" class="btn btn-primary topmarg">Modifica</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>
    </body>


    <div class="modal fade" id="informazioniRistoranteModal" tabindex="-1" aria-labelledby="informazioniRistoranteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="informazioniRistoranteModalLabel">Informazioni sul ristorante</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="/inserisci-ristorante" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="nomeRistoranteInput" class="form-label">Nome del ristorante</label>
                            <input type="text" class="form-control shadow-sm" id="nomeRistoranteInput"name="nomeRistorante" required>
                        </div>
                        <div class="mb-3">
                            <label for="immagineCopertinaInput" class="form-label">Immagine di copertina (JPEG, JPG)</label>
                            <input type="file" class="form-control shadow-sm" id="immagineCopertinaInput" name="immagineCopertinaInput" accept=".jpg,.jpeg" required>
                            <small class="text-muted">Inserisci l'immagine di copertina del tuo ristorante</small>
                        </div>
                        <div class="mb-3">
                            <label for="categoria" class="form-label">Categoria</label>
                            <select class="form-select shadow-sm" name="categoria" aria-label="Seleziona categoria" required>
                                <option selected disabled>Seleziona categoria...</option>
                                <% categorie.forEach(categoria => { %> 
                                    <option value="<%= categoria.nome %>"><%= categoria.nome %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="cittàInput" class="form-label">Città</label>
                            <input type="text" class="form-control shadow-sm" id="cittàInput" name="citta" required>                        
                        </div>
                        <div class="mb-3" >
                            <label for="indirizzoInput" class="form-label">Indirizzo</label>
                            <input type="text" class="form-control shadow-sm" id="indirizzoInput" name="indirizzo" required>
                        </div>
                        <div class="mb-3">
                            <label for="telefonoInput" class="form-label">Telefono</label>
                            <input type="number" class="form-control shadow-sm" id="telefonoInput" name="telefono" required>
                        </div>
                        <div class="mb-3">
                            <label for="paroleChiaveInput" class="form-label">Parole chiave</label>
                            <input type="text" class="form-control shadow-sm" id="paroleChiaveInput" name="paroleChiave" required>
                        </div>
                        <div class="mb-3">
                            <label for="descrizioneRistoranteInput" class="form-label">Descrizione</label>
                            <textarea class="form-control shadow-sm" id="descrizioneRistoranteInput" name="descrizione" rows="4" required></textarea>
                        </div>
                        
                            
                            <!-- Orari di Pranzo e Cena -->
                            <label class="form-label">Orari di apertura</label>
                            <div class="card p-3 mb-4 shadow-sm">
                                <div class="row mb-3">
                                    <!-- Apertura Pranzo -->
                                    <div class="col-md-6 mb-3">
                                        <label for="orarioAperturaPranzo" class="form-label">Apertura Pranzo</label>
                                        <input type="time" class="form-control shadow-sm" id="orarioAperturaPranzo" name="orarioAperturaPranzo">
                                    </div>
                                    <!-- Chiusura Pranzo -->
                                    <div class="col-md-6 mb-3">
                                        <label for="orarioChiusuraPranzo" class="form-label">Chiusura Pranzo</label>
                                        <input type="time" class="form-control shadow-sm" id="orarioChiusuraPranzo" name="orarioChiusuraPranzo">
                                    </div>
                                </div>

                                <div class="row">
                                    <!-- Apertura Cena -->
                                    <div class="col-md-6 mb-3">
                                        <label for="orarioAperturaCena" class="form-label">Apertura Cena</label>
                                        <input type="time" class="form-control shadow-sm" id="orarioAperturaCena" name="orarioAperturaCena">
                                    </div>
                                    <!-- Chiusura Cena -->
                                    <div class="col-md-6 mb-3">
                                        <label for="orarioChiusuraCena" class="form-label">Chiusura Cena</label>
                                        <input type="time" class="form-control shadow-sm" id="orarioChiusuraCena" name="orarioChiusuraCena">
                                    </div>
                                </div>
                                <small class="text-muted">Se il tuo Ristorante apre una sola volta al giorno, lascia vuoti gli altri campi</small>
                            </div>

                        <div class="mb-3m">
                            <label for="promoAttiveInput" class="form-label">Promo attive</label>
                            <textarea class="form-control shadow-sm" id="promoAttiveInput" name="promo" rows="2" required></textarea>
                        </div>   
                    
                        <div class="mb-3">
                            <label for="menuPDFInput" class="form-label">Menu (PDF)</label>
                            <input type="file" class="form-control shadow-sm" id="menuPDFInput" name="menuPDFInput" accept=".pdf" required>
                            <small class="text-muted">Carica il menu in formato PDF</small>
                        </div>
                        
                        <div class="text-center">
                            <button type="submit" class="btn btn-outline-dark ">Aggiungi ristorante</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    

    
</html>