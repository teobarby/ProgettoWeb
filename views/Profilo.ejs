<!DOCTYPE ejs>
<html lang="it">
    <%- include('partials/head'); %>
        <body>

        <%- include('partials/navbar'); %>

        <header class="bg-dark pt-4 pb-4">
            <div class="container px-4 px-lg-5 my-0">
                <div class="text-center text-white"  data-aos="zoom-in">
                    <h1 class="display-4 fw-bolder">Il Tuo Profilo</h1>
                    <p class="lead fw-normal text-white-50 mb-0">Visualizza e gestisci le informazioni del tuo profilo.</p>
                    <button class="btn btn-outline-light topmarg" id="modificaButton" data-bs-toggle="modal" data-bs-target="#modificaModal">Modifica</button>
                    
                    <button class="btn btn-outline-light topmarg ms-2" id="eliminaRistoranteButton" data-bs-toggle="modal" data-bs-target="#eliminaModal">Elimina Account</button>
                </div>
            </div>
        </header>
        
        <section class="py-5"  data-aos="zoom-in">
            <div class="container card px-4 px-lg-5 mt-2 mb-2">
                <div class="row gx-4 gx-lg-5">
                    <div class="col-lg-6 mb-3 mt-4">
                        <h2 class="section-heading mb-4">Informazioni Personali</h2>

                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Nome e Cognome</h5>
                                <p class="card-text"><%= nome %> <%= cognome %></p>                            
                            </div>
                        </div>
                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title">Nome Utente</h5>
                                <p class="card-text"><%= username %></p>
                            </div>
                        </div>
                        
                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title">Email</h5>
                                <p class="card-text"><%= email %></p>
                            </div>
                        </div>
                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title">Numero di telefono</h5>
                                <p class="card-text"><%= cellulare %></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 mb-3 mt-4">
                        <!-- Altri dettagli del profilo -->
                        <h2 class="section-heading mb-4">Preferenze e Statistiche</h2>
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Prenotazioni</h5>
                                <p class="card-text">Hai <%= statistiche.prenotazioniCount || 0 %> prenotazioni memorizzate</p>
                            </div>
                        </div>
                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title">Preferenze</h5>
                                <p class="card-text">Hai <%= statistiche.preferitiCount || 0 %> ristoranti preferiti</p>
                            </div>
                        </div>
                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title">Recensioni</h5>
                                <p class="card-text">Fino ad oggi hai scritto <%= statistiche.recensioniCount || 0 %> recensioni</p>
                            </div>
                        </div>
                       
                    </div>
                    <div class="text-center mt-5">
                        <% if (possiedeRistorante) { %>
                            <button type="button" class="btn btn-outline-dark mb-4" data-bs-toggle="modal" data-bs-target="#informazioniRistoranteModal" onclick="caricaInfoRistorante()">Modifica Ristorante</button>
                            <button type="button" class="btn btn-outline-danger mb-4 ms-2" data-bs-toggle="modal" id="eliminaButton" data-bs-target="#eliminaRistoranteModal" onclick="eliminaRistorante()">Elimina Ristorante</button>

                        <% } else { %>
                            <button type="button" class="btn btn-outline-dark mb-4" data-bs-toggle="modal" data-bs-target="#informazioniRistoranteModal">Aggiungi il tuo Ristorante</button>
                        <% } %>
                    </div>
                </div>
            </div>

            
        </section>

        <div class="modal fade" id="eliminaModal" tabindex="-1" aria-labelledby="modificaModalLabel" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="modificaModalLabel">Conferma Eliminazione Account</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <p>Sei sicuro di voler eliminare il tuo account? Questa azione è <strong>irreversibile</strong> e tutti i tuoi dati e quelli del tuo ristorante (se presenti) andranno persi. Non sarà possibile tornare indietro.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark ms-4" data-bs-dismiss="modal">Annulla</button>
                    <button type="button" class="btn btn-outline-danger ms-2" id="confirmDeleteButton" data-username="<%= username %>">Conferma Eliminazione</button>
                </div>
              </div>
            </div>
        </div>


        <div class="modal fade" id="eliminaRistoranteModal" tabindex="-1" aria-labelledby="modificaModalLabel" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="modificaModalLabel">Conferma Eliminazione Ristorante</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <p>Sei sicuro di voler eliminare il tuo Ristorante? Questa azione è <strong>irreversibile</strong> e tutti i tuoi dati andranno persi. Non sarà possibile tornare indietro.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark ms-4" data-bs-dismiss="modal">Annulla</button>
                    <button type="button" class="btn btn-outline-danger ms-2" id="confirmDeleteRestaurantButton" data-username="<%= username %>">Conferma Eliminazione</button>
                </div>
              </div>
            </div>
        </div>

        <div class="modal fade" id="modificaModal" tabindex="-1" aria-labelledby="modificaModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modificaModalLabel">Modifica profilo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/update-profilo" method="POST" id="modificaForm">
                            <div class="mb-3">
                                <label for="nomeInput" class="form-label">Nome</label>
                                <input type="text" class="form-control" name="nome" id="nomeModalInput" value="<%= nome %>"  maxlength="20" required>
                            </div>
                            <div class="mb-3">
                                <label for="cognomeInput" class="form-label">Cognome</label>
                                <input type="text" class="form-control" name="cognome" id="cognomeModalInput" value="<%= cognome %>"  maxlength="25" required>
                            </div>
                            <div class="mb-3">
                                <label for="usernameInput" class="form-label">Username</label>
                                <input type="text" class="form-control" name="nuovoUsername" id="UsernameModalInput" value="<%= username %>"  maxlength="30" required>
                            </div>
                            <div class="mb-3">
                                <label for="emailInput" class="form-label">Email</label>
                                <input type="email" class="form-control" name="email" id="emailModalInput" value="<%= email %>"  maxlength="30" required>
                            </div>
                            <div class="mb-3">
                                <label for="telefonoInput" class="form-label">Telefono</label>
                                <input type="tel" class="form-control" name="cellulare" id="telefonoModalInput" value="<%= cellulare %>"  pattern="[0-9]*" maxlength="15" required>
                            </div>
                            <div class="text-center">
                                <button type="submit" class="btn btn-primary topmarg">Modifica</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>
    </body>


    <div class="modal fade" id="informazioniRistoranteModal" tabindex="-1" aria-labelledby="informazioniRistoranteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="informazioniRistoranteModalLabel">Informazioni sul ristorante</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="/<%= possiedeRistorante ? 'modifica-ristorante' : 'inserisci-ristorante' %>" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="nomeRistoranteInput" class="form-label">Nome del ristorante</label>
                            <input type="text" class="form-control shadow-sm" id="nomeRistoranteInput" name="nomeRistorante" value="<%= (ristoranti.length > 0 ? ristoranti[0].nome : '') %>" required maxlength="40" pattern=".*\S+.*" title="Il campo Nome non può essere vuoto o contenere solo spazi.">
                        </div>
                        <div class="mb-3">
                            <label for="immagineCopertinaInput" class="form-label">Immagine di copertina (JPEG, JPG)</label>
                            <input type="file" class="form-control shadow-sm" id="immagineCopertinaInput" name="immagineCopertinaInput" accept=".jpg,.jpeg" required>
                            <% if(possiedeRistorante) { %>
                                <small class="text-muted">Carica la nuova copertina (jpg, jpeg)</small>
                            <% } else { %>
                                <small class="text-muted">Inserisci l'immagine di copertina</small>
                            <% } %> 
                        </div>
                        <div class="mb-3">
                            <label for="categoria" class="form-label">Categoria</label>
                            <select class="form-select shadow-sm" name="categoria" aria-label="Seleziona categoria"required>
                                <option value="" disabled selected>Seleziona categoria...</option>
                                <% categorie.forEach(categoria => { %>
                                    <option value="<%= categoria.nome %>" 
                                        <%= (ristoranti.length > 0 && ristoranti[0].categoria === categoria.nome) ? 'selected' : '' %>>
                                        <%= categoria.nome %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="cittàInput" class="form-label">Città</label>
                            <input type="text" class="form-control shadow-sm" id="cittàInput" name="citta" value="<%= (ristoranti.length > 0 ? ristoranti[0].citta : '') %>" required maxlength="50" pattern=".*\S+.*" title="Il campo Città non può essere vuoto o contenere solo spazi.">
                        </div>
                        <div class="mb-3">
                            <label for="indirizzoInput" class="form-label">Indirizzo</label>
                            <input type="text" class="form-control shadow-sm" id="indirizzoInput" name="indirizzo" value="<%= (ristoranti.length > 0 ? ristoranti[0].indirizzo : '') %>" required maxlength="50" pattern=".*\S+.*" title="Il campo Indirizzo non può essere vuoto o contenere solo spazi.">
                        </div>
                        <div class="mb-3">
                            <label for="telefonoInput" class="form-label">Telefono</label>
                            <input type="tel" class="form-control shadow-sm" id="telefonoInput" name="telefono" pattern="[0-9]*" value="<%= (ristoranti.length > 0 ? ristoranti[0].telefono : '') %>" required maxlength=15" title="Il campo Telefono non può essere vuoto o contenere solo spazi.">
                        </div>
                        <div class="mb-3">
                            <label for="paroleChiaveInput" class="form-label">Parole chiave</label>
                            <input type="text" class="form-control shadow-sm" id="paroleChiaveInput" name="paroleChiave" value="<%= (ristoranti.length > 0 ? ristoranti[0].paroleChiave : '') %>" required maxlength="40" title="Il campo Parole chiave non può essere vuoto o contenere solo spazi.">
                            <small class="text-muted">Premi invio dopo aver scritto ogni categoria, puoi inserirne 3 al massimo</small>
                        </div>
                        <div class="mb-3">
                            <label for="descrizioneRistoranteInput" class="form-label">Descrizione</label>
                            <textarea class="form-control shadow-sm" id="descrizioneRistoranteInput" name="descrizione" rows="4" required maxlength="1000"><%= (ristoranti.length > 0 ? ristoranti[0].descrizione : '') %> </textarea>
                        </div>
                        <label class="form-label">Orari di apertura</label>
                        <div class="card p-3 mb-4 shadow-sm">
                            <div class="row mb-3">
                                <div class="col-md-6 mb-3">
                                    <label for="orarioAperturaPranzo" class="form-label">Prima Apertura</label>
                                    <input type="time" class="form-control shadow-sm" id="orarioAperturaPranzo" name="orarioAperturaPranzo" value="<%= (ristoranti.length > 0 ? ristoranti[0].orarioAperturaPranzo : '') %>" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="orarioChiusuraPranzo" class="form-label">Prima Chiusura</label>
                                    <input type="time" class="form-control shadow-sm" id="orarioChiusuraPranzo" name="orarioChiusuraPranzo" value="<%= (ristoranti.length > 0 ? ristoranti[0].orarioChiusuraPranzo : '') %>" required>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="orarioAperturaCena" class="form-label">Seconda Apertura</label>
                                    <input type="time" class="form-control shadow-sm" id="orarioAperturaCena" name="orarioAperturaCena" value="<%= (ristoranti.length > 0 ? ristoranti[0].orarioAperturaCena : '') %>">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="orarioChiusuraCena" class="form-label">Seconda Chiusura</label>
                                    <input type="time" class="form-control shadow-sm" id="orarioChiusuraCena" name="orarioChiusuraCena" value="<%= (ristoranti.length > 0 ? ristoranti[0].orarioChiusuraCena : '') %>">
                                </div>
                            </div>
                            <small class="text-muted">Se il tuo Ristorante apre una sola volta al giorno, lascia vuoti i campi in basso</small>
                        </div>
                        <div class="mb-3">
                            <label for="promoAttiveInput" class="form-label">Promo attive</label>
                            <textarea class="form-control shadow-sm" id="promoAttiveInput" name="promo" rows="2" maxlength="200"><%= (ristoranti.length > 0 ? ristoranti[0].promo : '') %></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="menuPDFInput" class="form-label">Menu (PDF)</label>
                            <input type="file" class="form-control shadow-sm" id="menuPDFInput" name="menuPDFInput" accept=".pdf" required>
                            <% if(possiedeRistorante) { %>
                                <small class="text-muted">Carica il nuovo menu (pdf)</small>
                            <% } else { %>
                                <small class="text-muted">Carica il menu (pdf)</small>
                            <% } %> 


                           
                        </div>
                        <% if(possiedeRistorante) { %>
                            <div class="text-center">
                                <button type="submit" class="btn btn-outline-dark ">Conferma Modifiche</button>
                            </div>
                        <% } else { %>
                            <div class="text-center">
                                <button type="submit" class="btn btn-outline-dark ">Aggiungi ristorante</button>
                            </div>
                        <% } %>
                        
                    </form>
                </div>
            </div>
        </div>
    </div>

    
<script>
    AOS.init();
</script>

<script  src="https://cdn.jsdelivr.net/npm/@yaireo/tagify"></script>

<script>
    document.getElementById('confirmDeleteButton').addEventListener('click', function() {
        const username = this.getAttribute('data-username'); 
        console.log('Eliminazione richiesta per:', username); 



        fetch(`/delete-user/${username}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
        }
        })
        .then(response => {
            if (response.ok) {
                return response.json(); 
            } else {
                return response.json().then(data => { throw new Error(data.message); });
            }
        })
        .then(data => {
            console.log(data.message);  
            window.location.href = `/?_=${new Date().getTime()}`; 
        })
        .catch(error => {
            console.error('Errore durante l\'eliminazione:', error);
            alert('Errore durante l\'eliminazione: ' + error.message);
        });
    });




    document.getElementById('confirmDeleteRestaurantButton').addEventListener('click', function() {
        const username = this.getAttribute('data-username');  
        console.log('Eliminazione richiesta per:', username); 



        fetch(`/delete-rest/${username}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => {
            if (response.ok) {
                return response.json(); 
            } else {
                return response.json().then(data => { throw new Error(data.message); });
            }
        })
        .then(data => {
            console.log(data.message); 
            location.reload(); 
        })
        .catch(error => {
            console.error('Errore durante l\'eliminazione:', error);
            alert('Errore durante l\'eliminazione: ' + error.message);
        });
    });


    let input = document.querySelector('input[name="paroleChiave"]');

    new Tagify(input, {
        maxTags: 3  // Imposta il limite a 3 tag/parole
    });

    document.querySelector('#paroleChiaveInput').addEventListener('keydown', function(e) {
        if(e.key === 'Enter') {
            e.preventDefault();
        }
    });
   
</script>
    
</html>