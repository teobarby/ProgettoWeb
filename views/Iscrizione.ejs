<!DOCTYPE ejs>
<html lang="it">
<%- include('partials/head'); %>
<body>
    <%- include('partials/navbar'); %>
    <!-- Page Content-->
    <div class="container my-4">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow-lg border-0 rounded-lg mt-0">
                    <div class="card-header"><h3 class="text-center font-weight-light my-4">Iscriviti a GustoInRete</h3></div>
                    <div class="card-body">
                        <form class="mb-0" action="/signup" method="post">
                            <div class="form-floating mb-3">
                                <input class="form-control" name="nome" id="inputName" type="text" placeholder="Nome" required pattern=".*\S.*" title="Il campo Nome non può essere vuoto o contenere solo spazi." maxlength="20"/>
                                <label for="inputName">Nome</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input class="form-control" name="cognome" id="inputSurname" type="text" placeholder="Cognome" required pattern=".*\S.*" title="Il campo Cognome non può essere vuoto o contenere solo spazi." maxlength="25"/>
                                <label for="inputSurname">Cognome</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input class="form-control" id="username" name="username" type="text" placeholder="Username" autocomplete="username" required maxlength="30"/>
                                <label for="username">Username</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input class="form-control" name="email" id="inputEmail" type="email" placeholder="name@example.com" required maxlength="30"/>
                                <label for="inputEmail">Email</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input class="form-control" name="cellulare" id="inputPhone" type="tel" placeholder="Telefono" required pattern="[0-9]*" title="Inserisci un numero di telefono valido" maxlength="15"/>
                                <label for="inputPhone">Telefono</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input 
                                    class="form-control" 
                                    name="password" 
                                    id="inputPassword" 
                                    type="password" 
                                    placeholder="Password" 
                                    required 
                                    pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}" 
                                    title="La password deve contenere almeno 8 caratteri, di cui almeno una maiuscola, una minuscola e un simbolo." 
                                    maxlength="30"
                                />
                                <label for="inputPassword">Password</label>
                            </div>
                            <div class="d-grid gap-2 center-container">
                                <button class="btn btn-primary mx-auto" type="submit">Iscriviti</button>
                            </div>
                        </form>
                    </div>
                    <div class="card-footer text-center py-3 mt-1">
                        <div class="small"><a href="/login">Hai già un account? Accedi</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    
    

</body>
</html>
