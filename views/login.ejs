<!DOCTYPE ejs>
<!-- Login -->
<html lang="it">
    <%- include('partials/head'); %>
<body>
    <%- include('partials/navbar'); %>
    <div class="container my-5" data-aos="zoom-in">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow-lg border-0 rounded-lg mt-5">
                    <div class="card-header"><h3 class="text-center font-weight-light my-4">Accedi con il tuo Profilo</h3></div>
                    <div class="card-body">
                        <form action="/login/password" method="post" class="mb-0">
                            <div class="form-floating mb-3">
                                <input class="form-control" id="username" name="username" type="text" autocomplete="username" placeholder="Name" required autofocus maxlength="30"/>
                                <label for="username">Username</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input class="form-control" id="current-password" name="password" type="password" autocomplete="current-password" placeholder="Name" required maxlength="30">
                                <label for="inputPassword">Password</label>
                            </div>
                            <% if (message) { %>
                                <div class="alert alert-danger mb-0 mt-2 mb-3">
                                  <%= message %>
                                </div>
                            <% } %>
                            <div class="d-grid gap-2 center-container">
                                <button class="btn btn-primary" type="submit">Accedi</button>
                            </div>
                        </form>
                    </div>
                    <div class="card-footer text-center py-3">
                        <div class="small"><a href="/iscrizione">Non hai un account? Iscriviti</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script>
        AOS.init();
    </script>
</body>
</html>