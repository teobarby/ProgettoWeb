                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" href="/topPreferiti">Top 3 Preferiti</a></li>
                    </ul>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 ms-lg-4">
              
                <form class="d-flex mb-0" action="/cerca" method="GET">
                    
                    <input type="text" name="keyword" class="form-control me-2" placeholder="Cerca ristorante..." required>
                    
                    <button class="btn btn-outline-dark" type="submit"><i class="bi bi-search"></i></button>
                </form>
               
                <li class="nav-item dropdown">
                <% if (username) { %>
                    <a class="btn dropdown-toggle ms-3" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <%= username %>
                    </a>
                    <ul class="dropdown-menu ms-1" aria-labelledby="navbarDropdown">
                        <li><a class="dropdown-item" href="/Profilo">Profilo</a></li>
                        <li><a class="dropdown-item" href="/Risposte">Risposte dai Proprietari</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/CronologiaPrenotazioni">Le tue Prenotazioni</a></li>
                        <li><a class="dropdown-item" href="/CronologiaPrenotazioniRistorante">Pr. del tuo Ristorante</a></li>
                        <li><hr class="dropdown-divider"></li>
